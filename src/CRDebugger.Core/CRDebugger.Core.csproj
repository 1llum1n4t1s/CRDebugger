<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>CRDebugger.Core</RootNamespace>
    <!-- テスト・サンプル用にビルドするが、NuGetパッケージとしては公開しない -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Microsoft.Extensions.Logging.Abstractions は
       .NET 11 の共有フレームワーク (Microsoft.NETCore.App) に含まれるため PackageReference しない。
       明示参照すると NU1510（フレームワーク提供パッケージの冗長参照）になる。.NET 8 系ターゲットは廃止済み。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="CRDebugger.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>
</Project>
