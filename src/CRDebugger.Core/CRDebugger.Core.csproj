<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>CRDebugger.Core</RootNamespace>
    <!-- テスト・サンプル用にビルドするが、NuGetパッケージとしては公開しない -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CRDebugger.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- SuperLightLogger 1.0.10 が Microsoft.Extensions.Logging.Abstractions >= 10.0.10 を要求するため、
         net8.0 / net10.0 共通で 10.0.10 を指定。利用者側で 8.x 系の依存衝突が出る場合は
         NuGet の Floating Version 解決で 10.0.10 に揃う想定。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="SuperLightLogger" Version="1.0.12" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>
</Project>
