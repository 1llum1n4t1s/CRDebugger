<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>CRDebugger.WinForms</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CRDebugger.WinForms</PackageId>
    <Description>CRDebugger WinForms UI - SRDebugger-like debug panel for WinForms apps. Add runtime debugging, logging console, options editor, and profiler to any WinForms application.</Description>
  </PropertyGroup>

  <!-- Microsoft.Extensions.Logging.Abstractions は
       .NET 11 の共有フレームワーク (Microsoft.NETCore.App) に含まれるため PackageReference しない。
       明示参照すると NU1510（フレームワーク提供パッケージの冗長参照）になる。.NET 8 系ターゲットは廃止済み。 -->
  <ItemGroup>
    <!-- Coreのソースファイルを直接コンパイル（NuGet依存なし） -->
    <Compile Include="..\CRDebugger.Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\CRDebugger.Core\obj\**;..\CRDebugger.Core\bin\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>
</Project>
