<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>CRDebugger.Wpf</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CRDebugger.Wpf</PackageId>
    <Description>CRDebugger WPF UI - SRDebugger-like debug panel for WPF apps. Add runtime debugging, logging console, options editor, and profiler to any WPF application.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Coreのソースファイルを直接コンパイル（NuGet依存なし） -->
    <Compile Include="..\CRDebugger.Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\CRDebugger.Core\obj\**;..\CRDebugger.Core\bin\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- SuperLightLogger 1.0.12 が Logging.Abstractions >= 10.0.10 を要求するため、TFM 共通で 10.0.10 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="SuperLightLogger" Version="1.0.12" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
  </ItemGroup>
</Project>
